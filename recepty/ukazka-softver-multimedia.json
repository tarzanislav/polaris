    },
    {
      "type": "program",
      "id": "mediainfo",
      "winget": "MediaArea.MediaInfo.GUI",
      "displayName": "MediaInfo",
      "match": "Prefix",
      "note": "informácie o médiách (BSD)"
    },
    {
      "type": "program",
      "id": "subtitleedit",
      "winget": "Nikse.SubtitleEdit",
      "displayName": "Subtitle Edit",
      "match": "Prefix",
      "note": "titulky (MIT)"
    },
    {
      "type": "program",
      "id": "obs",
      "winget": "OBSProject.OBSStudio",
      "displayName": "OBS Studio",
      "match": "Prefix",
      "note": "nahrávanie obrazovky a prezentácií (GPL)"
    },
    {
      "type": "program",
      "id": "blender",
      "winget": "BlenderFoundation.Blender",
      "displayName": "Blender",
      "match": "Prefix",
      "note": "3D – len na silné PC (GPL)"
