{
  // Ukážkový recept: základné nastavenia PC v učebni (K4a).
  // Pracovná skupina rovnaká ako Samba na serveri, časové pásmo, Windows Update a napájanie cez politiky Windows.
  "schema": 1,
  "name": "ZAKLAD",
  "version": 4,
  "note": "Ukážka: pracovná skupina SKOLA, stredoeurópsky čas, aktualizácie mimo vyučovania, napájanie pre učebňu, bez OneDrive a zrýchleného Edge, prihlásenie žiaka bez otázok o súkromí a bez uvítania Edge",
  "elements": [
    {
      "type": "computer",
      "id": "pocitac",
      "workgroup": "SKOLA",
      "timeZone": "Central Europe Standard Time",
      "note": "zmena pracovnej skupiny sa prejaví po reštarte"
    },
    {
      "type": "updates",
      "id": "aktualizacie",
      "activeHoursStart": 7,
      "activeHoursEnd": 17,
      "deferFeatureDays": 30,
      "note": "počas vyučovania Windows PC nereštartuje; novú verziu Windows o mesiac neskôr"
    },
    {
      "type": "power",
      "id": "napajanie",
      "sleepMinutes": 60,
      "displayMinutes": 15,
      "hibernateMinutes": 0,
      "powerButton": "ShutDown",
      "fastStartup": false,
      "note": "vypnuté PC naozaj začína odznova, Wake on LAN funguje spoľahlivejšie"
    },
    {
      "type": "registry",
      "id": "edge-bez-zrychlenia",
      "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge",
      "name": "StartupBoostEnabled",
      "kind": "DWord",
      "data": "0",
      "note": "Edge nebeží na pozadí po prihlásení (pre všetky kontá)"
    },
    {
      "type": "registry",
      "id": "edge-bez-uvitania",
      "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Edge",
      "name": "HideFirstRunExperience",
      "kind": "DWord",
      "data": "1",
      "note": "profil žiaka je vždy nový – bez toho by Edge pri každom prihlásení ukázal uvítanie"
    },
    {
      "type": "registry",
      "id": "onedrive-vypnuty",
      "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "name": "DisableFileSyncNGSC",
      "kind": "DWord",
      "data": "1",
      "note": "práce žiakov patria na školský server, nie do OneDrive"
    },
    {
      "type": "user-registry",
      "id": "onedrive-bez-instalacie",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
      "name": "OneDriveSetup",
      "present": false,
      "note": "nový profil (aj žiaka po každom čistení) si OneDrive neinštaluje"
    },
    {
      "type": "registry",
      "id": "bez-otazok-o-sukromi",
      "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OOBE",
      "name": "DisablePrivacyExperience",
      "kind": "DWord",
      "data": "1",
      "note": "profil žiaka sa maže – bez toho by sa každý žiak pri prihlásení pýtal na polohu, diagnostiku …"
    },
    {
      "type": "registry",
      "id": "bez-uvodnej-animacie",
      "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
      "name": "EnableFirstLogonAnimation",
      "kind": "DWord",
      "data": "0",
      "note": "prvé prihlásenie (u žiaka každé) bez animácie „Ahoj“ – rýchlejšie"
    }
  ]
}
