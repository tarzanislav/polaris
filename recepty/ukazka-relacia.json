{
  // Ukážkový recept: spoločné konto žiaka bez hesla, ktoré sa po zapnutí PC prihlási samo, a jeho profil z trezoru.
  // Trezor pripraví správca raz: polaris-agent trezor priprav ziak → prihlásiť sa ako žiak, nastaviť, odhlásiť sa →
  // polaris-agent trezor ulozit ziak. Kým trezor nie je, profil sa po odhlásení maže (čistý štart).
  // Čistí služba POLARIS agent (polaris-agent instalovat-sluzbu).
  "schema": 1,
  "name": "RELACIA",
  "version": 4,
  "note": "Ukážka: konto žiaka bez hesla s automatickým prihlásením, profil z trezoru po každom odhlásení, pripnuté v Štarte aj pre nové kontá, klávesnice, prípony súborov, Školský obchod",
  "elements": [
    {
      "type": "account",
      "id": "konto-ziak",
      "name": "ziak",
      "noPassword": true,
      "autoLogon": true,
      "note": "bez hesla (žiak nepracuje s citlivými údajmi, profil sa vždy vráti), heslo si nenastaví, cez sieť sa doň nedá prihlásiť; po zapnutí PC sa prihlási samo"
    },
    {
      "type": "session",
      "id": "relacia-ziak",
      "account": "ziak",
      "clean": "Restore",
      "note": "každý žiak začína v pripravenom profile z trezoru"
    },
    {
      "type": "start-layout",
      "id": "start-nove-profily",
      "from": "ziak",
      "note": "programy pripnuté v Štarte pri príprave trezoru žiaka dostane aj každé nové konto (napr. učiteľa) – namiesto ponúk Windows"
    },
    {
      "type": "keyboards",
      "id": "klavesnice",
      "languages": [ "sk-SK", "cs-CZ", "en-US", "de-DE" ],
      "note": "prvá je predvolená"
    },
    {
      "type": "user-registry",
      "id": "pripony-suborov",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "HideFileExt",
      "kind": "DWord",
      "data": "0",
      "note": "prípony súborov sú vidno – faktura.pdf.exe sa neschová (kyberbezpečnosť)"
    },
    {
      "type": "store",
      "id": "skolsky-obchod",
      "accounts": [ "ziak" ],
      "maxPerSession": 2,
      "note": "žiak si program nainštaluje sám (polaris-agent obchod), po odhlásení sa odstráni",
      "items": [
        {
          "id": "audacity",
          "title": "Audacity",
          "description": "nahrávanie a strih zvuku",
          "program": { "type": "program", "id": "audacity", "winget": "Audacity.Audacity", "displayName": "Audacity", "match": "Prefix" }
        },
        {
          "id": "inkscape",
          "title": "Inkscape",
          "description": "vektorová grafika",
          "program": { "type": "program", "id": "inkscape", "winget": "Inkscape.Inkscape", "displayName": "Inkscape", "match": "Prefix" }
        }
      ]
    }
  ]
}
