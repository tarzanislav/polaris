<Project Sdk="Microsoft.NET.Sdk">
  <!-- polaris-centrum: the owner's tool for the centre's settings file (bells, groups, profiles, timetable, days off).
       It reads and writes that file and the publication; "server" serves the publication read-only over HTTPS. Runs on Linux and Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Polaris.Centrum</RootNamespace>
    <AssemblyName>polaris-centrum</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Polaris.Core\Polaris.Core.csproj" />
    <ProjectReference Include="..\Polaris.Net\Polaris.Net.csproj" />
    <ProjectReference Include="..\Polaris.Install\Polaris.Install.csproj" />
    <ProjectReference Include="..\Polaris.Web\Polaris.Web.csproj" />
    <ProjectReference Include="..\Polaris.Windows\Polaris.Windows.csproj" />
  </ItemGroup>
</Project>
